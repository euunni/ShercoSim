universe   = vanilla
executable = 10GeV.sh
arguments  = $(ProcId)

output = /your/path/Cosmic_e-_5GeV/log/$(ProcId).out
error = /your/path/Cosmic_e-_5GeV/log/$(ProcId).err
log = /your/path/Cosmic_e-_5GeV/log/$(ProcId).log

request_memory = 1 GB

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files =./bin, ./lib, ./init.mac, ./Cosmic_e-_5GeV.mac

queue 500
